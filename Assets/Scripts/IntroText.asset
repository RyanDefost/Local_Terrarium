  dialogueItems:
  - Text: '"hmmm.." '
    type: 0
  - Text: '[Na het overleiden van je opa, heb jij de verantwoordelijkheid voor mijn
      vuurtoren overgenomen.]'
    type: 0
  - Text: '[Een grote verantwoordelijkheid.]'
    type: 0
  - Text: "[Ook heb jij een schaalmodel van het dorp ge\xEBrfd.]"
    type: 0
  - Text: '[Een gelieft project van je opa; zei dat het veel mensen heeft geholden,
      wat dat ook mag betekenen.]'
    type: 0
  - Text: '"Hoorde ik net de deurbel? beter om even te kijken wie er is."'
    type: 0
